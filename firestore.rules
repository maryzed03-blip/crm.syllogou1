rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PILOT: όλοι οι συνδεδεμένοι χρήστες του ΔΣ έχουν κοινή πρόσβαση.
    // Απαιτεί ενεργό Anonymous Authentication στο νέο Firebase project.
    // Πριν γίνει δημόσιο production URL, προτείνεται μετάβαση σε login με
    // συγκεκριμένα emails του ΔΣ αντί για anonymous access.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
